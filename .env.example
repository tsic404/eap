# Template for `.env` — `cp .env.example .env`, then `make setup-env`.
# `replace-me-*` entries are placeholders: they satisfy the compose files'
# `${VAR:?}` non-empty checks, but nobody can authenticate with them. The dev
# defaults kept as-is (POSTGRES_PASSWORD and the DATABASE_URL embedding it, Redis
# and the compose-internal hosts) work for local development only. Production
# replaces environment-specific values item by item — see deploy/checklist.md.
#
# ===== Shared infrastructure =====
# PostgreSQL (shared by backend and Dify; pgvector enabled)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=eap
# Dev default — replace in prod together with the password embedded in DATABASE_URL.
POSTGRES_PASSWORD=eap_password
POSTGRES_DB=eap

# Redis (shared by backend and Dify; no password in local dev)
REDIS_HOST=redis
REDIS_PORT=6379

# Weaviate vector store (shared by backend RAG and Dify)
WEAVIATE_URL=http://weaviate:8080
# `make setup-env` replaces this placeholder with a random key. Prod required.
WEAVIATE_API_KEY=replace-me-weaviate-api-key
WEAVIATE_API_USER=eap@example.com

# ===== Backend (FastAPI) =====
APP_ENV=development
BACKEND_PORT=3001
DATABASE_URL=postgresql+asyncpg://eap:eap_password@postgres:5432/eap
REDIS_URL=redis://redis:6379/0
DIFY_API_BASE_URL=http://dify-api:5001
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== Entry (nginx) =====
# Published port and the origin the browser uses to reach it. Keep them in step:
# OIDC_REDIRECT_URI and the CORS allow-list derive from PUBLIC_ORIGIN, while
# NGINX_PORT only maps the port.
NGINX_PORT=80
PUBLIC_ORIGIN=http://localhost

# ===== OIDC / SSO =====
# Local development serves SSO from the in-repo mock IdP (`mock-idp`, the same
# stub the e2e/QA stacks use). These three values take precedence over the OIDC
# block below, so `docker compose up -d` logs in as alice@acme.com (seeded as
# agent_admin) with no IdP; they follow MOCK_IDP_PORT, and compose interpolates
# this reference from the value above. Blank all three to use a real IdP.
MOCK_IDP_PORT=4000
MOCK_IDP_ISSUER=http://localhost:${MOCK_IDP_PORT:-4000}
MOCK_IDP_DISCOVERY_URL=http://mock-idp:${MOCK_IDP_PORT:-4000}
MOCK_IDP_CLIENT_ID=e2e-client

# Prod required — issuer URL + client credentials from your IdP's OIDC app.
# The placeholders below cannot authenticate anyone: discovery resolves against
# the reserved, non-resolving `replace-me-idp.invalid`.
OIDC_ISSUER=https://replace-me-idp.invalid
OIDC_CLIENT_ID=replace-me-oidc-client-id
OIDC_CLIENT_SECRET=replace-me-oidc-client-secret
# The stub is a PKCE public client: in local development this value is sent to
# `mock-idp` verbatim and never checked, so the placeholder above is harmless
# there (blanking the MOCK_IDP_* trio is what makes it matter).
OIDC_DISCOVERY_URL=
# Empty → compose default: dev http://localhost/api/auth/callback, prod
# https://localhost/api/auth/callback. Prod must set the real public https
# callback URL — COOKIE_SECURE=true drops the refresh cookie on an http callback.
OIDC_REDIRECT_URI=

# ===== JWT =====
# Prod required — RS256 keypair for access/refresh tokens. Inline the PEMs here as
# double-quoted values (multi-line, or a single line with `\n` escapes): that is
# the path prod compose interpolates into the container. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY=replace-me-jwt-private-key-pem
JWT_PUBLIC_KEY=replace-me-jwt-public-key-pem
# The local stack ignores both: it mounts the keypair `make setup-env` generates
# into deploy/keys/ (gitignored) as read-only secrets.

# ===== Dify =====
# `make setup-env` replaces this placeholder with a random key. Prod required.
DIFY_SECRET_KEY=replace-me-dify-secret-key
# Prod required — Dify console (admin/owner) account used for app / dataset /
# model management; it is the account Dify asks for on first console setup.
# Missing or wrong credentials, or a workspace without a configured model
# provider, surface as `dify: error` on `/api/health/ready`.
DIFY_CONSOLE_EMAIL=replace-me@example.com
DIFY_CONSOLE_PASSWORD=replace-me-dify-console-password

# Plugin daemon internal keys (Dify 1.x runs model/tool plugins out-of-process).
# `make setup-env` replaces these placeholders with random keys; any 32-hex
# string works. The api, worker and plugin daemon must all agree on them, and
# they never leave the compose network. Prod required.
PLUGIN_DAEMON_KEY=replace-me-plugin-daemon-key
PLUGIN_DIFY_INNER_API_KEY=replace-me-plugin-dify-inner-api-key

# Max plugin package size in bytes, shared by the api/worker (`PLUGIN_MAX_PACKAGE_SIZE`)
# and the plugin daemon (`MAX_PLUGIN_PACKAGE_SIZE`). Optional — defaults to 50 MiB.
PLUGIN_MAX_PACKAGE_SIZE=52428800

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
# Sentry DSN (optional — SDK no-ops when unset).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
