# ===== Shared infrastructure =====
# PostgreSQL (shared by backend and Dify; pgvector enabled)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=eap
POSTGRES_PASSWORD=eap_password
POSTGRES_DB=eap

# Redis (shared by backend and Dify; no password in local dev)
REDIS_HOST=redis
REDIS_PORT=6379

# Weaviate vector store (shared by backend RAG and Dify)
# Required — generate a strong key, e.g. `openssl rand -hex 32`.
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=
WEAVIATE_API_USER=eap@example.com

# ===== Backend (FastAPI) =====
APP_ENV=development
BACKEND_PORT=3001
DATABASE_URL=postgresql+asyncpg://eap:eap_password@postgres:5432/eap
REDIS_URL=redis://redis:6379/0
DIFY_API_BASE_URL=http://dify-api:5001
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== OIDC / SSO =====
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost/api/auth/callback

# ===== JWT =====
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ===== Dify =====
# Required — generate a strong key, e.g. `openssl rand -hex 32`.
DIFY_SECRET_KEY=
DIFY_CONSOLE_EMAIL=
DIFY_CONSOLE_PASSWORD=

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
